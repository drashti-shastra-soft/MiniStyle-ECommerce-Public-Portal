    </script>
</head>
<body>
    <div id="videoLoader">
        <video id="loaderVideo" autoplay muted>            
            <source src="@Url.Content("~/images/loadervideo.mp4")" type="video/mp4" style="height:200px;"/>
        </video>
    </div>

    <header class="ManiHeader">
