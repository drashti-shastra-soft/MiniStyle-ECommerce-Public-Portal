          "@@type": "ClothingStore",
          "name": "Mini Style",
          "url": "https://ministyle.in",
          "logo": "https://ministyle.in/logo.png",
          "image": "https://ministyle.in/cover-image.jpg",
          "description": "Mini Style is a premium clothing store for newborns to 12-year-old kids, offering trendy and comfortable outfits for boys and girls in Surat, Gujarat.",
          "address": {
            "@@type": "PostalAddress",
            "streetAddress": "Shop No. 132, 1st Floor, Orchid Harmony, Fire Station, Gaurav Path Road, opp. Palanpor, Pal Gam",
            "addressLocality": "Surat",
            "addressRegion": "Gujarat",
            "postalCode": "395009",
            "addressCountry": "IN"
          },
          "geo": {
            "@@type": "GeoCoordinates",
            "latitude": 21.170240,
            "longitude": 72.831062
          },
          "hasMap": "https://maps.app.goo.gl/Yu5QEwj8agkco9hk6",
          "telephone": "+91 63524 89688",
          "email": "ministyle.official25@gmail.com",
          "priceRange": "$$",
          "openingHours": "Mo-Su 11:00-20:00",
          "contactPoint": {
            "@@type": "ContactPoint",
            "telephone": "+91 63524 89688",
            "contactType": "Customer Service",
            "areaServed": "IN",
            "availableLanguage": "en"
          },
          "sameAs": [
            "https://www.instagram.com/mini_style_official/"
          ],
          "keywords": ["Kids Clothing", "Baby Clothes", "Newborn Outfits", "Boys Clothing", "Girls Clothing", "Kids Fashion", "Surat Kids Store"],
          "productCategory": [
