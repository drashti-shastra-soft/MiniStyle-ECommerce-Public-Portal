@{
    var canonicalUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <!-- SEO Meta Tags -->
    <meta name="keywords" content="@ViewBag.MetaKeywords" />
    <meta name="description" content="@ViewBag.MetaDescription" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Canonical URL -->
    <link rel="canonical" href="@Html.Raw(canonicalUrl)" />
    <link href="@Url.Content("~/css/bootstrap.min.css")" rel="stylesheet" />
    <link href="@Url.Content("~/css/style.css")" rel="stylesheet" />
    <link href="@Url.Content("~/css/responsive.css")" rel="stylesheet" />
    <link href="@Url.Content("~/css/owl.carousel.min.css")" rel="stylesheet" />
    <link href="@Url.Content("~/css/owl.theme.default.min.css")" rel="stylesheet" />
    <link href="@Url.Content("~/css/swiper-bundle.min.css")" rel="stylesheet" />
    <link href="@Url.Content("~/css/sitefonts.css")" rel="stylesheet" />
    <link rel="icon" type="image/ico" sizes="32x32" href="@Url.Content("~/images/favicon32.ico")">
    <link href="@Url.Content("~/toastr/toastr.min.css")" rel="stylesheet" />

    <!-- Jquery -->
    <script src="@Url.Content("~/js/jquery-3.5.1.js")"></script>
    <!-- Font Awesome -->
    <script src="@Url.Content("~/js/fontawesome.min.js")"></script>
    <!-- Boostrap -->
    <script src="@Url.Content("~/js/bootstrap.min.js")"></script>
    <!-- Carousel -->
    <script src="@Url.Content("~/js/owl.carousel.min.js")"></script>
    <!-- Swiper -->
    <script src="@Url.Content("~/js/swiper.min.js")"></script>
    <!-- toastr -->
    <script src="@Url.Content("~/toastr/toastr.min.js")"></script>
    <!-- Extra JS -->
    <script src="@Url.Content("~/js/extra.js")"></script>
    
    <!-- Custom Notification -->
    <script src="@Url.Content("~/js/custom-notification.js")"></script>
    
    <!-- Custom Function -->
    <script src="@Url.Content("~/js/custom-functions.js")"></script>

    <script type="application/ld+json">
        {
