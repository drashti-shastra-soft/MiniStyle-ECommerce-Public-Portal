                            <img src="@Url.Content("~/images/aboutus/pic4.webp")" alt="About Image" class="img-fluid customImg" loading="lazy" />
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <div class="imageBox even">
                            <img src="@Url.Content("~/images/aboutus/pic5.webp")" alt="About Image" class="img-fluid" loading="lazy" />
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <div class="imageBox even">
                            <img src="@Url.Content("~/images/aboutus/pic6.webp")" alt="About Image" class="img-fluid" loading="lazy" />
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6">
