<section class="FAQSections section-gap">
    <img src="@Url.Content("~/images/vector/crocodile.webp")" class="img-fluid crocodileFloat" loading="lazy" />
    @* <img src="~/images/vector/bigcloud.webp" class="bigCloud img-fluid" loading="lazy"> *@
    <img src="@Url.Content("~/images/vector/cloud.webp")" class="img-fluid cloudfloat cloud2" loading="lazy">
    <div class="WrapperContainer">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-12">
                    <div class="headingSection text-center">
                        <h3>Mini Style FAQs</h3>
                        <h2>
                            Frequently <span class="color2">Asked</span> <span class="color3"> Questions</span>
                        </h2>
                        <div class="headingDescription">
                            <p>Have questions about Mini Style? Find all the answers about our kids' clothing, sizes, returns, and more right here!</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-12">
                    <div class="FaQcontent">
                        <div class="accordion" id="accordionExample">
                            <div class="accordion-item">
                                <h2 class="accordion-header" id="headingOne">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                                        What is Mini Style?
                                    </button>
                                </h2>
                                <div id="collapseOne" class="accordion-collapse collapse" aria-labelledby="headingOne" data-bs-parent="#accordionExample">
                                    <div class="accordion-body">
                                        <p>Mini Style is a kids' clothing brand that offers stylish, comfortable, and high-quality apparel for children aged 0 to 12 years. Our collection includes trendy outfits, everyday essentials, and occasion wear designed with love and care.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="accordion-item">
                                <h2 class="accordion-header" id="headingTwo">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                                        What age groups do you cater to?
                                    </button>
                                </h2>
                                <div id="collapseTwo" class="accordion-collapse collapse" aria-labelledby="headingTwo" data-bs-parent="#accordionExample">
                                    <div class="accordion-body">
                                        <p>We provide clothing for newborns, infants, toddlers, and kids up to 12 years. Our sizes are designed to ensure a perfect fit for every stage of childhood.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="accordion-item">
                                <h2 class="accordion-header" id="headingThree">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseThree" aria-expanded="false" aria-controls="collapseThree">
                                        What types of clothing does Mini Style offer?
                                    </button>
                                </h2>
                                <div id="collapseThree" class="accordion-collapse collapse" aria-labelledby="headingThree" data-bs-parent="#accordionExample">
                                    <div class="accordion-body">
                                        <p>Our collection includes:</p>
                                        <ul>
                                            <li><i class="fas fa-angle-right mr-1"></i>Casual wear (t-shirts, shorts, jeans, dresses, etc.)</li>
                                            <li><i class="fas fa-angle-right mr-1"></i>Party wear (stylish frocks, suits, ethnic wear, etc.)</li>
                                            <li><i class="fas fa-angle-right mr-1"></i>Sleepwear (comfortable nightwear and pajamas)</li>
                                            <li><i class="fas fa-angle-right mr-1"></i>Seasonal clothing (sweaters, jackets, and summer essentials)</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                            <div class="accordion-item">
                                <h2 class="accordion-header" id="headingThree1">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseThree1" aria-expanded="false" aria-controls="collapseThree1">
                                        Are your clothes safe for kids’ skin?
                                    </button>
                                </h2>
                                <div id="collapseThree1" class="accordion-collapse collapse" aria-labelledby="headingThree1" data-bs-parent="#accordionExample">
                                    <div class="accordion-body">
                                        <p>Yes! We use soft, breathable, and skin-friendly fabrics to ensure maximum comfort and safety for your child. Our clothing is made from high-quality materials that are gentle on sensitive skin.</p>

                                    </div>
                                </div>
                            </div>
                            <div class="accordion-item">
                                <h2 class="accordion-header" id="headingThree2">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseThree2" aria-expanded="false" aria-controls="collapseThree2">
                                        Do you offer returns and exchanges?
                                    </button>
                                </h2>
                                <div id="collapseThree2" class="accordion-collapse collapse" aria-labelledby="headingThree2" data-bs-parent="#accordionExample">
                                    <div class="accordion-body">
                                        <p>Yes! We have a hassle-free return and exchange policy. If you receive a wrong size or a defective item, you can request an exchange within a specified period. Please check our return policy for detailed terms.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>