@model ministyle.Domain.ProductLister
@{
    ViewBag.Title = "Girls Clothing in Surat | Dresses & Custom Outfits – Mini Style";
    ViewBag.MetaDescription = "Explore beautiful girls’ clothing at Mini Style, Surat. From everyday wear to special occasion dresses, we create stylish & customized outfits for girls 0 to 12 years.";
    ViewBag.MetaKeywords = "girls clothing Surat, kids dresses Surat, custom girls outfits, party wear for girls, baby girl clothes, Mini Style girls fashion";
}

<section class="bredcrumbSection contactBread">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="breadHeading">
                    <h3>Girls</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="vectorDivision">
        <img src="@Url.Content("~/images/vector/sldiervector.png")" class="img-fluid" loading="lazy" />
    </div>
</section>

<section class="myproductsSection section-gap">
    <div class="WrapperContainer">
        <img src="@Url.Content("~/images/vector/sheep.webp")" class="img-fluid sheepfloat" loading="lazy" />
        <img src="@Url.Content("~/images/vector/sheepright.webp")" class="img-fluid sheepright" loading="lazy" />
        <img src="@Url.Content("~/images/vector/cloud.webp")" class="img-fluid cloudfloat cloud2" loading="lazy">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-12">
                    <div class="headingSection text-center">
                        <h3>Because Your Loved Ones Deserve the Best</h3>
                        <h2>
                            Discover <span class="color2">the </span> <span class="color3">Softest Essentials</span>
                        </h2>
                        <div class="headingDescription">
                            <p>Wrap your little one in comfort with our latest collection of newborn clothing, blankets, and cozy accessories.</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row" id="setBox">
                @using (Html.AjaxBeginForm("List", "Girls", new AjaxOptions
                {
                    HttpMethod = "POST",
                    UpdateTargetId = "divList",
                    LoadingElementId = "loading-element"
                }, new { id = "frmList" }))
                {
                    <div id="divList">
                        <partial name="_List" model="@Model" />
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="vectorDivision">
        <img src="@Url.Content("~/images/vector/sldiervector.png")" class="img-fluid" loading="lazy">
    </div>
</section>

<script>
     $(document).ready(function() {
        $.ajax({
            url: '@Url.Action("List", "Girls")',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify('@Model'),
           beforeSend: function () {
                $('#loading-element').show();
            },
            success: function (response) {
                $('#divList').html(response);
            },
            error: function (xhr) {
                $('#divList').html('<p>Error loading data.</p>');
            },
            complete: function () {
                $('#loading-element').hide();
            }
        });
    });



</script>