@model ministyle.Domain.ProductLister

@{
    Layout = null;
}

<div class="row">
    <div class="col-lg-10">
        <div class="SelectionBox">
            <ul class="nav nav-pills owl-carousel" id="pills-tab" role="tablist">
                @if (ViewBag.SubCategories != null && ViewBag.SubCategories is List<ministyle.Domain.SubCategory>)
                {
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="pills-profile-tab" data-bs-toggle="pill" data-bs-target="#pills-profile" type="button" role="tab" aria-controls="pills-profile" aria-selected="false">View All</button>
                    </li>

                    @foreach (var item in ViewBag.SubCategories)
                    {
                        var mSubCategory = (ministyle.Domain.SubCategory)item;

                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="pills-contact-tab" data-bs-toggle="pill" data-bs-target="#pills-contact" type="button" role="tab" aria-controls="pills-contact" aria-selected="false">@mSubCategory.Name</button>
                        </li>
                    }
                }
            </ul>
        </div>
    </div>
    <div class="col-lg-2">
        <div class="filter-dropdown-container">
            <div class="btn-group">
                <button type="button" class="dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                    Sort By <i class="fas fa-plus"></i>
                </button>
                <ul class="dropdown-menu">
                    <li><a class="dropdown-item" href="#">Recommended</a></li>
                    <li><a class="dropdown-item" href="#">Newest</a></li>
                    <li><a class="dropdown-item" href="#">Lowest Price</a></li>
                    <li><a class="dropdown-item" href="#">Highest Price</a></li>
                </ul>
            </div>
        </div>
    </div>
    
</div>

<div class="col-lg-12">
    <div class="tab-content" id="pills-tabContent">
        <div class="tab-pane fade show active" id="pills-profile" role="tabpanel" aria-labelledby="pills-profile-tab" tabindex="0">
            <div class="row allcloths">
                @if (Model != null && Model.List.Count > default(int))
                {
                    foreach (var item in Model.List)
                    {
                        <div class="col-lg-6 col-xl-4 col-md-6">
                            <a href="@Url.Action("Index", "ProductDetails", new { id = item.Id })" class="myClothBox">
                                    <div class="productWrapper">
                                    <div class="myClothBoxImages">
                                        <img src="data:image/jpg;base64,@item.ImageBase64String" alt="" class="img-fluid" loading="lazy" />
                                    </div>
                                    <div class="BestSellarTab">
                                        <p><i class="fas fa-star"></i>Bestsellar</p>
                                    </div>
                                </div>
                                <div class="myClothBoxDescription">
                                    <h2>@item.Name</h2>
                                    <div class="price-box-container">
                                        <span class="product-price">@item.DiscountedPriceFormatted</span>
                                        <span class="originalPriceBox">@item.SellPriceFormatted</span>
                                    </div>
                                    @* <span class="product-price">@item.UnitPrice</span> *@
                                </div>
                            </a>
                        </div>
                    }
                }
               
            </div>
        </div>

    </div>
</div>

<script>
    $(".dropdown-toggle").on("click", function () {
               let $icon = $(this).find("i");

               if ($icon.hasClass("fa-plus")) {
                       $icon.removeClass("fa-plus").addClass("fa-minus");
               } else {
                       $icon.removeClass("fa-minus").addClass("fa-plus");
               }
       });

       // Optional: reset icon when dropdown closes
       $(".dropdown-toggle").on("blur", function () {
               let $icon = $(this).find("i");
               $icon.removeClass("fa-minus").addClass("fa-plus");
       });

       $('.SelectionBox .nav-pills').owlCarousel({
            loop:false,
            margin:10,
            autoWidth:true,
            nav:false,
            responsive:{
                0:{
                    items:1
                },
                600:{
                    items:3
                },
                1000:{
                    items:6
            }
        }
    })
</script>