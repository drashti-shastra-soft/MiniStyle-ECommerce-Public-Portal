@{
    ViewBag.Title = "Thank You for Shopping with Mini Style | Kids Clothing Online";
    ViewBag.MetaDescription = "Your order has been placed successfully at Mini Style. Explore our newborn, girls, and boys custom clothing collections. Thank you for choosing us!";
    ViewBag.MetaKeywords = "Mini Style thank you page, kids clothing order confirmation, newborn clothes, girls clothes, boys clothes, custom kids clothing";
}

<style>
    .thankyou-card {
        background: rgb(195 225 219 / 20%);
        border-radius: 1.5rem;
        text-align: center;
        padding: 40px 30px;
        max-width: 450px;
        width: 100%;
        animation: fadeInUp 0.8s ease;
        border: 2px dashed #0CB1B9;
    }

    /* Success check animation */
    .checkmark {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        display: inline-block;
        position: relative;
        background: #28a745;
        margin-bottom: 20px;
        animation: scaleUp 0.5s ease forwards;
    }

        .checkmark i {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            font-size: 30px;
            color: #fff;
        }

    .order-info {
        background: #f8f9fa;
        border-radius: 1rem;
        padding: 15px;
        margin: 20px 0;
        font-size: 0.95rem;
    }

        .order-info p {
            margin-bottom: 10px !important;
        }

    .thankyou-card h1 {
        font-weight: 700;
        font-size: 2rem;
        margin-bottom: 15px;
    }

    .thankyou-card p {
        color: #6c757d;
        margin-bottom: 20px;
        text-align: center;
    }
</style>

<section class="aboutusSection section-gap">
    <div class="WrapperContainer">
        <img src="/images/vector/cloud.webp" class="img-fluid cloudfloat cloud1" loading="lazy">
        <img src="/images/vector/cloud.webp" class="img-fluid cloudfloat cloud2" loading="lazy">
        <img src="/images/vector/horse.webp" class="img-fluid horseFloat" loading="lazy">
        <img src="/images/vector/lion.webp" class="img-fluid lionFloat" loading="lazy">
        <div class="container-fluid">
            <div class="row">
                <div class="col-lg-4 offset-lg-4 d-flex justify-content-center">
                    <div class="thankyou-card">
                        <div class="checkmark">
                            <i class="fas fa-check"></i>
                        </div>
                        <h1>Thank You!</h1>
                        <p>Your payment was successful. We’re getting your order ready.</p>
                        <div class="order-info text-start">
                            <p><strong>Payment Status:</strong> Successful</p>
                            <p><strong>Expected Delivery:</strong> 5-7 working days</p>
                        </div>
                        <a href="@Url.Action("Index", "Home")" class="btn shop-now-btn">SHOP NOW</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
