@{
    ViewBag.Title = "Contact Mini Style | Kids Clothing Store in Surat";
    ViewBag.MetaDescription = "Get in touch with Mini Style – Kids Clothing Store in Surat. Visit us at Shop No.132, Orchid Harmony, Pal Gam. Store timing: 11 AM – 8 PM. Call today for custom kids clothing orders.";
    ViewBag.MetaKeywords = "contact Mini Style, kids clothing Surat location, baby wear Surat, children fashion Surat, custom clothing Surat";
}

<section class="bredcrumbSection contactBread">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="breadHeading">
                    <h3>Contact Us</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="vectorDivision">
        <img src="@Url.Content("~/images/vector/sldiervector.png")" class="img-fluid" loading="lazy" />
    </div>
</section>

<section class="contactusSection section-gap">
    <div class="WrapperContainer">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-12">
                    <div class="headingSection text-center">
                        <h3>Let’s Connect & Create Smiles</h3>
                        <h2>Connect <span class="color2">with </span> <span class="color3">Mini Style</span></h2>
                        <div class="headingDescription">
                            <p>We’d love to hear from you! Whether you have a question, need assistance, or want to share your thoughts, our team is here to help. Drop us a message, and let’s make magic together!</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-5">
                    <div class="contacImg">
                        <img src="@Url.Content("~/images/contactusform.webp")" alt="Contact Image" class="img-fluid" loading="lazy" />
                    </div>
                </div>
                <div class="col-lg-7">
                    <form class="row contact-form" id="contactForm">
                        <label for="name">Personal Data</label>
                        <div class="col-md-12">
                            <input type="text" id="name" placeholder="Enter your name" required>
                        </div>
                        <div class="col-md-6">
                            <input type="email" id="email" placeholder="Enter your email" required>
                        </div>
                        <div class="col-md-6">
                            <input type="text" id="phone" placeholder="Enter your phone number" required>
                        </div>
                        <div class="col-12 textsection">
                            <label for="message">Message</label>
                            <textarea id="message" rows="6" placeholder="Write your message"></textarea>
                        </div>
                        <div class="col-12">
                            <div class="contentitemdiv" style="margin-top: 10px;">
                                <a class="button buttondione" href="javascript:void(0);"><span>Send Message<i class="fas fa-paper-plane ml-1"></i></span></a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>