@model ministyle.Domain.CartSummary
@{
    Layout = null;
}

<div class="price-summary">
    <h5>Price Summary</h5>
    <div class="summary-row">
        <span>Total item price</span>
        <span>@Model.TotalPriceFormatted</span>
    </div>
    <div class="summary-row">
        <span>Item discount</span>
        <span>-@Model.DiscountedFormatted</span>
    </div>
    <div class="summary-row">
        <span>Shipping fee</span>
        <span>@Model.ShippingFeeFormatted</span>
    </div>
    <hr />
    <div class="summary-row total-price">
        <span>Total</span>
        <span>@Model.TotalFormatted</span>
    </div>
    <a href="@Url.Action("Index", "checkout")" class="checkout-btn">PROCEED TO CHECKOUT</a>
</div>